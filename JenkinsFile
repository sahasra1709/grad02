pipeline {
    agent any

    environment {
        JAVA_HOME = 'C:\\Program Files\\Java\\jdk-25'
        PATH = "${JAVA_HOME}\\bin;${env.PATH}"
    }

    stages {
        stage('Build') {
            steps {
                bat 'gradlew build'
            }
        }

        stage('Run') {
            steps {
                bat 'gradlew run'
            }
        }
    }
}
